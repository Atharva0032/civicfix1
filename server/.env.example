# ---------------------------------------------------------------------------
# CivicFix — Backend environment configuration
# Copy this file to `.env` and adjust the values for your machine.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma separated list of origins allowed to call the API (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Public base URL of this API. Used to build absolute URLs for locally
# stored uploads (e.g. http://localhost:5000/uploads/xyz.jpg).
PUBLIC_API_URL=http://localhost:5000

# --- Database --------------------------------------------------------------
# Leave EMPTY (or set to `memory://`) for a zero-configuration in-memory
# MongoDB that is automatically downloaded and persisted to `server/.mongo-data`.
# This is the recommended mode for local development & hackathon demos.
#
# For a real deployment point this at MongoDB Atlas or a self-hosted instance:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/civicfix?retryWrites=true&w=majority
MONGO_URI=

# Port used by the local in-memory MongoDB helper (development only).
MEMORY_DB_PORT=27777

# --- Authentication --------------------------------------------------------
# REQUIRED. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# --- Image storage ---------------------------------------------------------
# `local`  -> files are written to server/uploads (works out of the box)
# `cloudinary` -> files are uploaded to Cloudinary (requires credentials below)
STORAGE_DRIVER=local

# Maximum accepted upload size per file, in megabytes.
MAX_UPLOAD_MB=5

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civicfix

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=60

# --- Seed / demo data ------------------------------------------------------
# Password assigned to every account created by `npm run seed`.
SEED_DEFAULT_PASSWORD=CivicFix@123
