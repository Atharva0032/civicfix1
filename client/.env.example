# Base URL of the CivicFix API.
# Leave empty during local development — Vite proxies /api to http://localhost:5000.
# Set this when the frontend and backend are hosted on different domains, e.g.
# VITE_API_URL=https://civicfix-api.example.com/api
VITE_API_URL=

# Public site name shown in the UI (optional).
VITE_APP_NAME=CivicFix
