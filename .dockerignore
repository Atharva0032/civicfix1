# Dependencies are installed inside the image, never copied in.
**/node_modules

# Rebuilt during the client-build stage.
**/dist

# Secrets come from the environment (Render dashboard), not the build context.
**/.env
**/.env.*

# Local development state that must not leak into the image.
server/.mongo-data
server/uploads
**/.vite
**/*.log
npm-debug.log*

# Repository metadata and editor files.
.git
.gitignore
.vscode
.idea
**/.DS_Store
